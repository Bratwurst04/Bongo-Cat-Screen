{
  "version": "1.0",
  "display": {
    "show_cpu": true,
    "show_ram": true,
    "show_wpm": true,
    "show_time": true,
    "time_format_24h": true
  },
  "behavior": {
    "sleep_timeout_minutes": 1,
    "animation_sensitivity": 1.0,
    "idle_timeout_seconds": 1.0
  },
  "connection": {
    "com_port": "AUTO",
    "baudrate": 230400,
    "auto_reconnect": true,
    "timeout_seconds": 5
  },
  "startup": {
    "start_with_windows": true,
    "start_minimized": true,
    "show_notifications": true
  },
  "spotify": {
    "client_id": "",
    "api_min_interval_seconds": 0.5,
    "api_initial_interval_seconds": 1.0,
    "api_idle_interval_seconds": 3.0,
    "api_budget_short_total": 24,
    "api_budget_short_auto": 18,
    "api_budget_long_total": 8000,
    "api_budget_long_auto": 7200,
    "api_budget_day_playing_seconds": 5.0,
    "api_budget_night_playing_seconds": 30.0,
    "api_budget_day_idle_seconds": 15.0,
    "api_budget_night_idle_seconds": 60.0,
    "api_budget_night_start_hour": 0,
    "api_budget_night_end_hour": 8,
    "api_budget_timezone": "Europe/Stockholm"
  },
  "app_animations": {
    "enabled": false,
    "poll_seconds": 1.0,
    "rules": [
      {"match": "code.exe", "animation": "TYPING_NORMAL"},
      {"match": "spotify.exe", "animation": "HAPPY"}
    ]
  }
} 
